.upload-box {
  width: 100%;
}

.upload-area {
  width: 100%;
  height: 400rpx;
  border: 4rpx dashed #d1d5db;
  border-radius: 32rpx;
  background: #f9fafb;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
  overflow: hidden;
  box-sizing: border-box;
}

.upload-area.has-image {
  border: none;
  padding: 0;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.upload-icon {
  width: 96rpx;
  height: 96rpx;
  opacity: 0.5;
}

.upload-text {
  font-size: 28rpx;
  color: #6b7280;
}

.upload-preview {
  width: 100%;
  height: 100%;
  border-radius: 32rpx;
}

.upload-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: center;
}

.btn-remove {
  background: #fee2e2;
  color: #dc2626;
  border: none;
  border-radius: 16rpx;
  padding: 12rpx 32rpx;
  font-size: 28rpx;
  font-weight: 600;
}
