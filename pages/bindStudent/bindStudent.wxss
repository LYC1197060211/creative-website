/* pages/bindStudent/bindStudent.wxss */
page {
  background-color: #F8FAFC;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
}

.container {
  min-height: 100vh;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
}

/* ===== Header Section ===== */
.header {
  text-align: center;
  margin-bottom: 56rpx;
}

.logo-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 32rpx;
}

.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

.title {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1A1A2E;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 40rpx;
}

/* ===== Form Section ===== */
.form-section {
  flex: 1;
}

.form-item {
  margin-bottom: 32rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 16rpx;
  padding-left: 8rpx;
}

/* Input Wrapper with Soft UI Style */
.input-wrapper, .picker-wrapper {
  display: flex;
  align-items: center;
  background: #F1F5F9;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: inset 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.05),
              inset -2rpx -2rpx 4rpx rgba(255, 255, 255, 0.8);
  transition: all 0.3s ease;
}

.input-wrapper.input-focused {
  background: #FFFFFF;
  box-shadow: 0 0 0 3rpx rgba(102, 126, 234, 0.1),
              0 4rpx 12rpx rgba(102, 126, 234, 0.15);
  transform: translateY(-2rpx);
}

.input-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 16rpx;
  opacity: 0.6;
}

.input-field {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A2E;
  background: transparent;
}

.input-placeholder {
  color: #9CA3AF;
}

/* Picker Styles */
picker {
  display: block;
}

.picker-wrapper {
  position: relative;
  cursor: pointer;
}

.picker-wrapper.picker-empty {
  opacity: 0.8;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #1A1A2E;
  font-weight: 500;
}

.picker-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #9CA3AF;
}

.arrow-icon {
  width: 28rpx;
  height: 28rpx;
  margin-left: 16rpx;
  opacity: 0.5;
  transition: transform 0.3s ease;
}

picker:active .arrow-icon {
  transform: rotate(180deg);
}

/* Tips Section */
.tips-wrapper {
  display: flex;
  align-items: flex-start;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.05), rgba(118, 75, 162, 0.05));
  border-radius: 12rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}

.tips-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  margin-top: 2rpx;
}

.tips-text {
  flex: 1;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 36rpx;
}

/* ===== Submit Button ===== */
.submit-btn {
  margin-top: 56rpx;
  background: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  border: none;
  transition: all 0.3s ease;
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

.submit-btn-disabled {
  background: linear-gradient(135deg, #D1D5DB 0%, #9CA3AF 100%);
  box-shadow: 0 4rpx 12rpx rgba(156, 163, 175, 0.2);
  opacity: 0.6;
}

.btn-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #FFFFFF;
  letter-spacing: 2rpx;
}

/* ===== Responsive Adjustments ===== */
@media (max-width: 320px) {
  .title {
    font-size: 40rpx;
  }
  
  .subtitle {
    font-size: 24rpx;
  }
  
  .logo {
    width: 100rpx;
    height: 100rpx;
  }
}
