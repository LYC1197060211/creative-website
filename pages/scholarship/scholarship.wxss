/* pages/scholarship/scholarship.wxss */

/* 全局容器 */
.container {
  min-height: 100vh;
  background: #F8FAFC;
  padding: 16rpx;
  padding-bottom: 200rpx;
}

/* 卡片通用样式 - Soft UI */
.info-card,
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 24rpx rgba(30, 90, 168, 0.08),
              0 2rpx 8rpx rgba(30, 90, 168, 0.04);
}

/* 卡片标题 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #E2E8F0;
}

.icon-wrapper {
  margin-right: 16rpx;
}

.icon-circle {
  width: 48rpx;
  height: 48rpx;
  background: linear-gradient(135deg, #667EEA 0%, #1E5AA8 100%);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

/* 学生信息 */
.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.info-label {
  width: 120rpx;
  font-size: 28rpx;
  color: #64748B;
}

.info-input {
  flex: 1;
  height: 72rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1E293B;
  border: 2rpx solid #E2E8F0;
}

/* 分数高亮显示 */
.score-highlight {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #1E5AA8 100%);
  border-radius: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.score-label {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 表单行 */
.form-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label {
  width: 200rpx;
  font-size: 28rpx;
  color: #64748B;
}

.form-input {
  flex: 1;
  height: 72rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #1E293B;
  border: 2rpx solid #E2E8F0;
}

.form-picker {
  flex: 1;
  height: 72rpx;
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 0 20rpx;
  border: 2rpx solid #E2E8F0;
  display: flex;
  align-items: center;
}

.picker-display {
  font-size: 28rpx;
  color: #1E293B;
  line-height: 72rpx;
}

/* 结果显示框 */
.result-box {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #F1F5F9;
  border-radius: 12rpx;
  border-left: 6rpx solid #667EEA;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.result-text {
  font-size: 26rpx;
  color: #64748B;
  margin-right: 8rpx;
}

.result-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1E5AA8;
}

.note-text {
  font-size: 24rpx;
  color: #EF4444;
  margin-left: 8rpx;
}

/* 上传部分 */
.upload-section {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
}

.upload-btn {
  background: #F8FAFC;
  border: 2rpx dashed #CBD5E1;
  border-radius: 12rpx;
  font-size: 26rpx;
  color: #64748B;
  padding: 16rpx 32rpx;
  margin: 0;
}

.upload-hint {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #10B981;
}

/* 子模块 */
.subsection {
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx solid #E2E8F0;
}

.subsection:first-child {
  margin-top: 0;
  padding-top: 0;
  border-top: none;
}

.subsection-title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.subsection-title text {
  font-size: 28rpx;
  font-weight: 600;
  color: #334155;
}

.add-btn {
  background: linear-gradient(135deg, #667EEA 0%, #1E5AA8 100%);
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 20rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.3);
  margin: 0;
}

/* 列表项 */
.item-list {
  margin-top: 16rpx;
}

.list-item {
  background: #F8FAFC;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border: 2rpx solid #E2E8F0;
}

.item-content {
  flex: 1;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
}

.item-picker {
  background: #FFFFFF;
  border: 2rpx solid #CBD5E1;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  min-width: 160rpx;
}

.item-picker-full {
  background: #FFFFFF;
  border: 2rpx solid #CBD5E1;
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  flex: 1;
}

.picker-mini {
  font-size: 24rpx;
  color: #334155;
}

.picker-mini-small {
  font-size: 22rpx;
  color: #334155;
}

.item-score {
  font-size: 26rpx;
  font-weight: 700;
  color: #1E5AA8;
  margin-left: 8rpx;
}

.delete-btn {
  background: #FEE2E2;
  color: #EF4444;
  font-size: 22rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  border: none;
  margin: 0;
  margin-left: 8rpx;
}

/* 素质类总分 */
.quality-total {
  margin-top: 32rpx;
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.1) 0%, rgba(30, 90, 168, 0.1) 100%);
  border-left-color: #1E5AA8;
}

/* 底部操作区 */
.bottom-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #FFFFFF;
  padding: 24rpx 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.total-score-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: linear-gradient(135deg, #667EEA 0%, #1E5AA8 100%);
  border-radius: 16rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.total-label {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.total-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 按钮组 */
.button-group {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin: 0;
}

.action-btn.primary {
  background: linear-gradient(135deg, #667EEA 0%, #1E5AA8 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 20rpx rgba(102, 126, 234, 0.4);
}

.action-btn.secondary {
  background: #F1F5F9;
  color: #64748B;
  border: 2rpx solid #CBD5E1;
}

.action-btn.secondary:active {
  background: #E2E8F0;
}
